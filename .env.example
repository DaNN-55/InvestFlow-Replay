# 环境变量参考；run.sh 不会自动加载 .env 或本文件。
# 在当前终端使用 export NAME=value，再执行 ./run.sh；完整示例见 README。
INVESTFLOW_REPLAY_ENGINE_PORT=8775
INVESTFLOW_REPLAY_BACKEND_PORT=3110
INVESTFLOW_REPLAY_WEB_PORT=5180
# 行情供给模式：默认 tdx；fixture 为完全离线的 Demo 合成行情
# INVESTFLOW_REPLAY_MARKET_PROVIDER=tdx
# 同时隔离 Engine 行情缓存、应用账本和交易记录
# INVESTFLOW_REPLAY_STORAGE_ROOT=/absolute/path/to/storage
# INVESTFLOW_REPLAY_MARKET_DB_PATH=/absolute/path/to/market.duckdb
